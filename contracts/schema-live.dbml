}

Table yt_monthly_checkpoints {
  pipeline text [not null, note: "CHECK IN ('seed','sync')"]
  month date [not null]
  status text [not null, default: `'running'::text`, note: "CHECK IN ('running','completed','failed')"]
  last_video_id bigint
  processed_count integer [not null, default: 0, note: 'CHECK >= 0']
  success_count integer [not null, default: 0, note: 'CHECK >= 0']
  no_data_count integer [not null, default: 0, note: 'CHECK >= 0']
  failed_count integer [not null, default: 0, note: 'CHECK >= 0']
  skipped_invalid_id_count integer [not null, default: 0, note: 'CHECK >= 0']
  retry_count integer [not null, default: 0, note: 'CHECK >= 0']
  error_message text
  started_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  ended_at timestamptz

  indexes {
    (pipeline, month) [pk]
  }
}

