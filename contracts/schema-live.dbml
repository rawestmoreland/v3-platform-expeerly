Table retailer {
  id text [pk, not null]
  access_key text [not null, unique]
  name text [not null]
  slug text [unique]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table brand {
  id text [pk, not null]
  name text [not null, unique]
  logo text
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table companies_analytics_v2 {
  id bigint [pk, not null, default: `nextval('companies_analytics_v2_id_seq'::regclass)`]
  bubble_id text [unique]
  company_name text
  brand_ids jsonb [default: `'[]'::jsonb`]
  client_status text
  brand_analytics_ids bigint[] [default: `'{}'::bigint[]`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  hubspot_company_id varchar
  count_from date [note: "CHECK (count_from IS NULL OR date_trunc('month', count_from)::date = count_from)"]
}

Table users_analytics_v2 {
  id bigint [pk, not null, default: `nextval('users_analytics_v2_id_seq'::regclass)`]
  bubble_id text [unique]
  full_name text
  role text [note: "CHECK role IN ('reviewer','company','super_admin')"]
  company_id text [ref: > companies_analytics_v2.bubble_id]
  company_analytics_id bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table brands_analytics_v2 {
  id bigint [pk, not null, default: `nextval('brands_analytics_v2_id_seq'::regclass)`]
  bubble_id text [unique]
  company_id text [ref: > companies_analytics_v2.bubble_id]
  brand_name text
  brand_logo text
  company_analytics_id bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

