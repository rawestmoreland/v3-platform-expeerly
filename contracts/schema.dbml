Table products {
  id text [pk, not null]
  brand_id text
  campaign_id text
  category text
  description text
  expeerly_product_id text
  gtin_ean text
  gtin_ean_variants text[]
  image_url text [note: 'Product image bucket URL']
  product_name text
  product_name_slug text
  unique_category_id text
  upc text
  upc_variants text[]
  update_product_slugs integer
  value integer
  vendor_product_number text
  call_to_action_link text

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table product_ean_retailer_articles {
  id text [pk, not null]
  product_id text [not null]
  ean text [not null]
  galaxus_article_id text
  brack_article_id text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (product_id, ean) [unique]
  }
}

Table asset_groups {
  id text [pk, not null]
  campaign_id text [not null]
  campaign_application_id text
  product_id text
  reviewer_user_analytics_id bigint
  video_format video_format_enum [not null]
  status asset_group_status_enum [not null, default: 'not_submitted']
  editing_final_at timestamp
  editing_transcript_produced_at timestamp
  editing_transcript_ready_at timestamp
  editing_videos_final_watermarked_at timestamp
  scheduled_expeerly_at timestamp
  scheduled_on_facebook_at timestamp
  scheduled_on_instagram_at timestamp
  scheduled_on_tiktok_at timestamp
  scheduled_on_youtube_at timestamp
  submitted_at timestamp
  approved_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table brand_seo [note: 'Localized copy fragments used on video review pages; not a standalone brand page model'] {
  id text [pk, not null]
  brand_id text [not null, unique]
  site_title_en text
  site_title_de text
  site_title_fr text
  site_title_it text
  meta_description_en text
  meta_description_de text
  meta_description_fr text
  meta_description_it text
  body_text_en text
  body_text_de text
  body_text_fr text
  body_text_it text
  footer_seo_text_en text
  footer_seo_text_de text
  footer_seo_text_fr text
  footer_seo_text_it text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

