}

Table retailer {
  id text [pk]
  access_key text [not null, unique]
  name text [not null]
  slug text [unique]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table users_analytics_v2 {
  id bigint [pk, not null, default: `nextval('users_analytics_v2_id_seq'::regclass)`]
  bubble_id text [unique]
  auth_user_id uuid [unique, note: 'FK → auth.users.id; set by signup trigger or seed']
  auth_method auth_method_enum [default: 'email', note: 'How the linked Auth user signed up; v1 email only']
  first_name text
  last_name text
  age integer [note: 'Self-reported age or snapshot; prefer DOB-derived age in product if policy requires']
  email text
  email_verification_status email_verification_status_enum [not null, default: 'unverified']
  avatar_url text [note: 'Profile image URL (CDN or object storage)']
  phone_number text [note: 'Prefer E.164 when validated; legacy imports may be free-form']
  social_linkedin text [note: 'Profile URL or handle as stored']
  social_instagram text
  social_facebook text
  social_tiktok text
  reviewer_rating real [note: 'Aggregate reviewer score for profile / matching; sourcing TBD']
  sample_image_bucket_urls text[] [note: 'Object storage or HTTPS links to sample stills for reviewer profile']
  sample_video_bucket_urls text[] [note: 'Object storage or HTTPS links to sample reels / portfolio clips']
  interest_unique_category_ids text[] [default: `'{}'::text[]`, note: 'interest_categories.unique_category_id values; no FK—app validates against catalog when needed']
  spoken_language_codes text[] [default: `'{}'::text[]`, note: 'language_options.code when aligned to catalog (same convention as campaigns.reviewer_languages); no FK']
  stripe_connect_account_id text [note: 'Stripe Connect account id (acct_…); address and KYC live on Stripe unless copied elsewhere']
  role users_analytics_role_enum
  hubspot_owner text [not null, default: `'theresa@expeerly.com'::text`, note: 'HubSpot owner; value is often the owner proxy email (philipp@expeerly.com | philipp.r@expeerly.com | lea@expeerly.com | theresa@expeerly.com); default for reviewer users is theresa']
  reviewer_status reviewer_profile_status_enum [note: 'Reviewer profile status from backoffice options']
  company_id text
  company_analytics_id bigint
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table video_tag [note: 'Legacy Bubble-era string FKs; joins may be partial/null in old rows'] {
  id text [pk, note: 'Same field as export unique_id; labeled id in this contract for overview only—not a directive to rename columns in SQL.']
  asset_group_id text [note: 'v3: asset_groups.id; null for legacy imports']
  Video_Upload text
  Video_Track text
  Processed_Video_ID text
  "Subtitle language" text
  "Subtitle file" text
  "Script language" text
  "Plain text script" text
  "Main language" text
  "ISO subtitle language codes" text
  "ISO script language code" text
  "ISO main language code" text
  Format text
  Duration text
  Company text
  Campaign text
  Brand text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table video_track {
  id text [pk, note: 'Same field as export unique_id; labeled id in this contract for overview only—not a directive to rename columns in SQL.']
  File text
  Video_Tag_ID text
  Processed_Video_ID text
  External_ID text
  ISO_language_code text
  Language text
  Migration_version text
  Status text
  Type text
  Value_text text
  vttFile text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table video_upload {
  id text [pk, note: 'Same field as export unique_id; labeled id in this contract for overview only—not a directive to rename columns in SQL.']
  status video_upload_status_enum [not null, default: 'in_progress', note: 'Canonical upload pipeline state']
  asset_group_id text [note: 'v3: asset_groups.id; null for legacy imports']
  Asset_id text
  "Upload status" text
  "Upload id" text
  "Static renditions" text
  "Public playback ids" text
  "Private playback ids" text
  "Original file size" text
  "Mux playback ID" text
  "Master url" text
  "File name" text
  Duration text
  "Asset status" text
  "Aspect ratio" text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table yt_monthly_checkpoints {
  pipeline text [not null, note: '\'seed\' | \'sync\'']
  month date [not null]
  status text [not null, default: `'running'::text`, note: '\'running\' | \'completed\' | \'failed\'']
  last_video_id bigint
  processed_count integer [not null, default: 0]
  success_count integer [not null, default: 0]
  no_data_count integer [not null, default: 0]
  failed_count integer [not null, default: 0]
  skipped_invalid_id_count integer [not null, default: 0]
  retry_count integer [not null, default: 0]
  error_message text
  started_at timestamp [not null, default: `now()`]
  ended_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (pipeline, month) [pk]
  }
}

// Planned v3 tables — text `id` PKs/FKs (opaque Bubble-style strings); bigint FKs only where pointing at
// analytics v2 (`*_analytics_id`, etc.). See file header ID rulebook.

Table campaigns {
  id text [pk, not null]
  company_analytics_id bigint [not null, note: 'Owning company in analytics v2']
  owner_user_analytics_id bigint [not null, note: 'Campaign owner (admin user) in analytics v2']
  campaign_type campaign_type_enum [not null, default: 'managed']
  status campaign_status_enum [not null, default: 'draft']
  name text [not null, note: 'Display name: brand + product name + id rules (product TBD)']
  reviews_per_product integer [note: 'Number of reviews per product']
  base_reviewer_payout_cents integer [not null, note: 'Fixed payout per reviewer for this campaign']
  product_id text [note: 'Chosen product → products.id; nullable if draft or multi-product model differs']
  highlights text [note: 'Reviewer guidance / highlights and intended use']
  product_choice_question text
  shipping_country_codes text[] [note: 'Restrict applicant shipping countries; values are countries.name']
  shipping_arrival_date date [note: 'Estimated product arrival for reviewers']
  pronunciation_hint text [note: 'Brand/product pronunciation guidance']
  pronunciation_sample_url text [note: 'MP3 etc. in object storage']
  instruction_pdf_url text [note: 'Optional instruction PDF in object storage']
  additional_incentive text
  reviewer_min_age integer
  reviewer_max_age integer
  reviewer_gender reviewer_gender_enum [note: 'Canonical enum labels; legacy Bubble text used Title Case (Male, Female, …)']
  reviewer_languages text[] [note: 'Languages reviewer may speak; values are language_options.code']
  screening_question text [note: 'Yes/No question for applicants; answer on campaign_applications when modeled']
  additional_subtitle_languages text[] [note: 'Beyond default EN, DE, FR, IT; values are language_options.code']
  additional_voice_over_languages text[] [note: 'Beyond default EN, DE, FR, IT; values are language_options.code']
  required_video_formats video_format_enum[]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table language_options {
  code text [pk, not null, note: 'Normalized key, e.g. en_us, de_ch']
  label text [not null, unique, note: 'Display label, e.g. English (US)']
  sort_order integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

