// WARNING: This schema is for context only and is not meant to be run.
// Table order and constraints may not be valid for execution.
// Live schema snapshot converted from SQL export (context only)
//
// ID rulebook (Bubble → Supabase migration + new app):
// - Analytics / legacy-export cluster (through `users_analytics_v2` below): entity PK is `id bigint`
//   (sequences); `bubble_id` text stays the stable join key to Bubble exports and legacy text FKs.
// - `processed_videos` bridges both worlds: `id bigint`, `bubble_id` text, plus text FKs (e.g. brand_id)
//   and bigint FKs (e.g. brand_analytics_id)—do not assume one implies the other without backfill.
// - From `// Planned v3 tables` onward: entity PKs / FKs are `id text` (opaque app-generated strings,
//   Bubble-style).
// - Legacy `video_upload` / `video_tag` / `video_track`: PK is labeled `id` here for naming consistency with
//   v3; live exports usually use `unique_id` for the same field—see the `id` column note on each table
//   (documentation only; not prescriptive for SQL or migrations).
// - New app: mint opaque text ids for v3 tables; inside analytics cluster prefer bigint `id` for joins.

// Enums
////////////////////////////////////////////////////

Enum status_enum {
  draft
  active
  inactive
  archived
  deleted
  pending
  blocked
}

Enum auth_method_enum {
  google
  facebook
  email
}

Enum user_role_enum {
  user
  client
  admin
  test
}

Enum campaign_application_status_enum {
  applied
  unsuccessful
  hired
  product_shipped_voucher
  submission_needed
  waiting_for_approval
  approved
  paid
}

Enum campaign_status_enum {
  draft
  review_and_submit
  published
  reviewers_hired
  shipping_confirmed
  waiting_for_submissions
  all_assets_submitted
  client_approval_pending
  assets_approved_payout_pending
  reviewers_paid
  in_editing
  in_distribution
  distribution_published
}

Enum campaign_type_enum {
  managed
  community
}

Enum company_client_status_enum {
  active
  paused
  pilot
  no_client_community
  agency
  partner
  churned
}

Enum reviewer_profile_status_enum {
  approval_pending
  onboarding_incomplete
  profile_approved
  profile_rejected
  onboarding_closed_due
}

Enum asset_group_feedback_kind_enum {
  to_reviewer
  company_user_to_admin
  admin_to_company_user
}

Enum asset_group_status_enum {
  not_submitted
  submitted
  client_approval_pending
  in_revision
  client_approved
  paid
  editing
  in_distribution
  published
}

Enum video_format_enum {
  portrait_9_16
  landscape_16_9
}

Enum video_upload_status_enum {
  in_progress
  failed
  completed
}

Enum hubspot_company_sync_job_status_enum {
  pending
  processing
  retry
  done
  not_found
  failed
}

Enum users_analytics_role_enum {
  reviewer
  company
  super_admin
}

Enum email_verification_status_enum {
  unverified
  pending
  verified
}

Enum reviewer_gender_enum {
  male
  female
  non_binary
  transgender
  other
}

Enum user_payout_payment_type_enum {
  base
  tip
}

Enum user_payout_status_enum {
  pending
  paid
  failed
  refunded
}

Table brands_analytics_v2 {
  id bigint [pk, not null, default: `nextval('brands_analytics_v2_id_seq'::regclass)`]
  bubble_id text [unique]
  company_id text
  brand_name text
  brand_logo text
  slug text [unique]
  website_url text
  company_analytics_id bigint
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table companies_analytics_v2 {
  id bigint [pk, not null, default: `nextval('companies_analytics_v2_id_seq'::regclass)`]
  bubble_id text [unique]
  company_name text
  company_website text [note: 'Corporate / marketing site URL']
  phone_number text [note: 'Main company line; prefer E.164 when validated']
  billing_address_id text [note: 'FK → addresses.id; address row should reference this company via company_analytics_id']
  vat_number text [note: 'EU VAT ID or local tax registration as applicable']
  hubspot_owner text [not null, default: `'philipp.r@expeerly.com'::text`, note: 'HubSpot owner; value is often the owner proxy email (philipp@expeerly.com | philipp.r@expeerly.com | lea@expeerly.com | theresa@expeerly.com)']
  brand_ids jsonb [default: `'[]'::jsonb`]
  client_status company_client_status_enum
  brand_analytics_ids bigint[] [default: `'{}'::bigint[]`]
  hubspot_company_id varchar
  count_from date
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table company_monthly_balances {
  id bigint [pk, not null, default: `nextval('company_monthly_balances_id_seq'::regclass)`]
  company_analytics_id bigint [not null]
  month date [not null]
  opening_view_credits integer [not null, default: 0]
  monthly_views bigint [not null, default: 0, note: 'CHECK (monthly_views >= 0)']
  view_deduction integer [not null, default: 0, note: 'CHECK (view_deduction >= 0)']
  closing_view_credits integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table hubspot_company_sync_jobs {
  id bigint [pk, not null, increment]
  company_analytics_id bigint [not null, unique]
  bubble_company_id varchar [not null]
  status hubspot_company_sync_job_status_enum [not null, default: 'pending']
  attempt_count integer [not null, default: 0, note: 'CHECK (attempt_count >= 0)']
  next_attempt_at timestamp [not null, default: `now()`]
  locked_at timestamp
  processed_at timestamp
  last_error text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table top_ups {
  id bigint [pk, not null, default: `nextval('top_ups_id_seq'::regclass)`]
  company_analytics_id bigint [not null]
  view_top_up integer [not null, default: 0, note: 'CHECK (view_top_up >= 0)']
  recorded_at date [not null, default: `date_trunc('month'::text, now())::date`]
  expires_at date [note: 'CHECK (expires_at is null or expires_at >= recorded_at)']
  synced_at timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table processed_videos [note: 'Bridge: bigint id + bubble_id + text FKs to bubble_id vs bigint *_analytics_id to analytics id; see file header ID rulebook'] {
  id bigint [pk, not null, default: `nextval('processed_videos_id_seq'::regclass)`]
  bubble_id text [unique]
  gtin_ean text
  gtin_ean_variants text[] [note: 'SQL export showed ARRAY']
  mux_playback_id text
  product text [default: `'no'::text`]
  product_name text
  asset_group text
  rating real
  reviewer_first_name text
  reviewer_last_name text
  reviewer_profile_pic text
  status text
  upc text
  upc_variants text[] [note: 'SQL export showed ARRAY']
  video_upload text
  brand_id text
  product_id text [note: 'Resolved product for public review route composition']
  unique_category_id text [note: 'Resolved category for public review route composition']
  public_review_id text [unique, note: 'Public URL id segment, e.g. /.../100000027']
  asset_id text
  Video_Tag_ID text
  Video_Track_ID text
  youtube_id text
  reviewer_id text
  published text [default: `''::text`]
  facebook_id text
  company_id text
  instagram_id text
  tiktok_id text
  loadbee_id text
  brand_analytics_id bigint
  company_analytics_id bigint
  reviewer_analytics_id bigint
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table processed_video_seo {
  public_review_id text [pk, not null]
  page_title_i18n jsonb
  site_title_i18n jsonb
  meta_description_i18n jsonb
  summary text
  transcript text
  faqs jsonb
  canonical_url text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table rendered_videos {
  id bigint [pk, not null, increment]

  company_bubble_id text [not null]
  brand_bubble_id text [not null]
  source_processed_video_id bigint [not null]
  source_processed_video_bubble_id text

  source_mux_asset_id text [not null]
  source_mux_playback_id text [not null]

  source_mux_track_id text [not null]
  source_mux_track_passthrough text
  source_track_name text
  source_language_code text

  output_mux_asset_id text
  output_mux_playback_id text

  status text [not null, default: `'pending'::text`]
  error text
  run_id text
  attempts integer [not null, default: 0]

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

}

